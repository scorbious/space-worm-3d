# Vite frontend: build-time actual endpoint; localhost only works for local development.
VITE_MULTIPLAYER_URL=ws://127.0.0.1:8787/ws
VITE_MULTIPLAYER_TRANSPORT=server
# Optional casual free P2P: use values from YOUR Firebase web app. Blank means unavailable.
# Firebase web config is public, NOT a service-account secret. Never set invented production values.
# See docs/P2P.md; enable Anonymous Auth and publish firebase.database.rules.json first.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional comma-separated stun:/stuns: URLs. Blank uses Google's public STUN (no TURN relay).
VITE_PEER_STUN_URLS=
# Node server (set in its own shell, not the Vite process):
# HOST=127.0.0.1
# PORT=8787
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DEV_ALLOW_SMALL_MATCH=1
# Production must set NODE_ENV=production and provide a real WSS endpoint.
