# Vite frontend: build-time actual endpoint; localhost only works for local development.
VITE_MULTIPLAYER_URL=ws://127.0.0.1:8787/ws
# Node server (set in its own shell, not the Vite process):
# HOST=127.0.0.1
# PORT=8787
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DEV_ALLOW_SMALL_MATCH=1
# Production must set NODE_ENV=production and provide a real WSS endpoint.
